<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="118dp"
    android:layout_margin="8dp"
    android:background="@drawable/bg_glass_card_soft"
    android:clickable="true"
    android:elevation="5dp"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">
    <TextView
        android:id="@+id/tvIcon"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:background="@drawable/bg_chip"
        android:gravity="center"
        android:text="+"
        android:textColor="@color/primary_cyan"
        android:textSize="26sp"
        android:textStyle="bold" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="14dp">
        <TextView android:id="@+id/tvModuleName" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Addition" android:textColor="@color/text_white" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvCategory" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Basics" android:textColor="@color/text_gray" android:textSize="12sp" />
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=">" android:textColor="@color/primary_cyan" android:textSize="26sp" android:textStyle="bold" />
</LinearLayout>
