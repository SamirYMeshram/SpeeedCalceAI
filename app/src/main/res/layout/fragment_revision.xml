        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Revision" android:textColor="@color/text_white" android:textSize="32sp" android:textStyle="bold" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerRevision" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:nestedScrollingEnabled="false" />
    </LinearLayout>
</ScrollView>
