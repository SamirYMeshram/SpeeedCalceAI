<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Quiz" android:textColor="@color/text_white" android:textSize="32sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/bg_glass_card" android:padding="22dp" android:text="Daily Quiz\n\n20 mixed questions. Score, rank, and percentile will be added in the Firebase phase." android:textColor="@color/text_white" android:textSize="20sp" android:textStyle="bold" />
        <Button android:id="@+id/btnErrorPractice" android:layout_width="match_parent" android:layout_height="62dp" android:layout_marginTop="16dp" android:background="@drawable/bg_outline_button" android:text="Error Practice" android:textAllCaps="false" android:textColor="@color/error_red" android:textStyle="bold" />
        <Button android:id="@+id/btnWorkout" android:layout_width="match_parent" android:layout_height="62dp" android:layout_marginTop="14dp" android:background="@drawable/bg_primary_button" android:text="Workout" android:textAllCaps="false" android:textColor="@color/text_white" android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
